# ==============================================================================
# MOTTU SMART OPS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Guidelines:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. In local dev/test, default values run 100% OFFLINE (Law 8 AGENTS.md).
# 3. For cloud production, update secrets, passwords, and API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OPERATION MODE
# ------------------------------------------------------------------------------
# false = Mottu Technical Evaluation (Rate Limit 50 req/h, Strict Auth)
# true  = Public Portfolio/Demo Mode (Rate Limit 5 req/h, Quick-Login buttons active)
PUBLIC_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. POSTGRESQL DATABASE (Postgres 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mottu_ops
POSTGRES_USER=mottu
POSTGRES_PASSWORD=mottu_dev_pass

# Host port mapping (isolated 1xxxx range to prevent local machine port collisions)
HOST_PORT_POSTGRES=15432

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & ASYNC QUEUES (Redis 7 Alpine)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# Host port mapping (isolated 1xxxx range)
HOST_PORT_REDIS=16379

# ------------------------------------------------------------------------------
# 4. SECURITY (JWT) & INTERNAL SERVICE-TO-SERVICE AUTH
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret (minimum 32 bytes required for HS256 security)
JWT_SECRET=trocar-em-producao-minimo-32-bytes-mottu-smart-ops-2026
# Token lifetime in seconds (28800 = 8 hours per contract)
JWT_EXPIRATION_SECONDS=28800

# Shared internal token passed in `X-Internal-Token` header between Java & Python
INTERNAL_API_TOKEN=internal-mottu-service-token-2026

# Internal service URL for core-api to reach intelligence-service inside Docker network
INTELLIGENCE_SERVICE_URL=http://intelligence-service:8000

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE S3 / MINIO (Inspection Photos)
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=mottu-inspections
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# Dual Endpoints (CRITICAL ARCHITECTURAL SEPARATION):
# - S3_INTERNAL_ENDPOINT: Used by Java backend and Python AI to read raw bytes
#   directly inside Docker network mottu-net for SHA-256 and dHash verification.
S3_INTERNAL_ENDPOINT=http://minio:9000

# - S3_PUBLIC_ENDPOINT: Used strictly by core-api S3Presigner to generate presigned
#   PUT upload URLs so browser/mobile clients can upload without 403 SigV4 error.
#   In Dev: http://localhost:19000
#   In Prod: https://your-domain.com/storage (proxied via Caddy)
S3_PUBLIC_ENDPOINT=http://localhost:19000

# Host port mappings for MinIO
HOST_PORT_MINIO_API=19000
HOST_PORT_MINIO_CONSOLE=19001

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE (Gemini Vision & CRAG) & STORE MINER
# ------------------------------------------------------------------------------
# Leave GEMINI_API_KEY blank in offline development.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Offline Autonomous Switch:
# true  = Synthetic vision & embedding responses (100% offline tests, zero API cost)
# false = Live calls to Google GenAI API
GEMINI_MOCK_MODE=true

# VTEX Mottu Parts Store base URL
VTEX_STORE_BASE_URL=https://www.loja.mottu.com.br

# Host port mapping for intelligence-service
HOST_PORT_INTELLIGENCE=18000

# ------------------------------------------------------------------------------
# 7. GOOGLE CLOUD BIGQUERY & LOOKER STUDIO (BI EXPORT)
# ------------------------------------------------------------------------------
# Offline Autonomous Switch:
# false = Analytics outbox events are queued in DB without attempting GCP upload
# true  = Batch NDJSON load jobs dispatched to BigQuery
BIGQUERY_ENABLED=false
GCP_PROJECT_ID=
BIGQUERY_DATASET=mottu_ops_bi
BIGQUERY_TABLE=fact_inspections

# Service Account credentials path (used when BIGQUERY_ENABLED=true)
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-bigquery-key.json

# Looker Studio embed report URL for manager dashboard T10
LOOKER_STUDIO_EMBED_URL=https://lookerstudio.google.com/embed/reporting/placeholder

# ------------------------------------------------------------------------------
# 8. APPLICATION & REVERSE PROXY HOST PORTS
# ------------------------------------------------------------------------------
HOST_PORT_CORE_API=18080
HOST_PORT_ANGULAR=14200
HOST_PORT_CADDY=18088
