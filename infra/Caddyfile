{
	auto_https disable_redirects
}

http://161.153.2.148, http://mottu-smart.duckdns.org, http://:80 {
	# Modern compression
	encode zstd gzip

	# Structured access logging
	log {
		output stdout
		format console
	}

	# Hardened HTTP Headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@pwa_no_cache path / /index.html /ngsw.json /ngsw-worker.js /manifest.webmanifest
	header @pwa_no_cache {
		Cache-Control "no-cache, no-store, must-revalidate"
		Pragma "no-cache"
		Expires "0"
	}

	# Spring Boot REST API & Server-Sent Events (SSE)
	handle /api/* {
		reverse_proxy core-api:8080 {
			flush_interval -1
		}
	}

	# MinIO S3 Object Storage Bucket (Direct bucket path for AWS SigV4 compliance)
	handle /mottu-inspections/* {
		reverse_proxy minio:9000 {
			header_up Host 161.153.2.148
		}
	}

	# MinIO S3 Object Storage (Strip /storage prefix for legacy paths)
	handle_path /storage/* {
		reverse_proxy minio:9000 {
			header_up Host 161.153.2.148
		}
	}

	# Angular 19 PWA SPA Fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

