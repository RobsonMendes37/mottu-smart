# Multi-stage Dockerfile for Mottu Smart Ops Frontend (Angular 19) + Caddy Reverse Proxy
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY apps/web-app/package*.json ./
RUN npm ci --ignore-scripts

COPY apps/web-app/ ./
RUN npm run build -- --configuration production

FROM caddy:2-alpine
COPY infra/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /app/dist/web-app/browser /srv

EXPOSE 80
